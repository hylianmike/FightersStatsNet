@model FightersStatsNet.Models.Attack

@{
    ViewData["Title"] = "Viewing Attack Details";
}

<h1>Viewing Attack Details</h1>

<div>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Name)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.ButtonInput)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.ButtonInput)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Fighter)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Fighter.Name)
        </dd>
    </dl>
</div>
<div>
    @if (User.Identity.IsAuthenticated)
    {
        <a asp-action="Edit" asp-route-id="@Model?.AttackId">Edit</a>
    }
    | <a asp-action="Index">Back to List</a>
</div>
