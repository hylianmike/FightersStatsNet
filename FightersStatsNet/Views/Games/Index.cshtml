@model IEnumerable<FightersStatsNet.Models.Game>

@{
    ViewData["Title"] = "All Games";
}

<h1>All Games</h1>

@if(User.Identity.IsAuthenticated) {
    <p>
        <a asp-action="Create">Add A New Game</a>
    </p>
}
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.YearOfRelease)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.YearOfRelease)
            </td>
            <td>
                @if(User.Identity.IsAuthenticated) {
                    <a asp-action="Edit" asp-route-id="@item.GameId">Edit</a>
                }
                | <a asp-action="Details" asp-route-id="@item.GameId">Details</a> |
                @if(User.Identity.IsAuthenticated) {
                    <a asp-action="Delete" asp-route-id="@item.GameId">Delete</a>
                }
            </td>
        </tr>
}
    </tbody>
</table>
