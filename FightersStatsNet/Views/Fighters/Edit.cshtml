@model FightersStatsNet.Models.Fighter

@{
    ViewData["Title"] = "Edit this Fighter";
}

<h1>Edit this Fighter</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="FighterId" />
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Gender" class="control-label"></label>
                <select asp-for="Gender" class="form-control">
                    <option value="M">Male</option>
                    <option value="F">Female</option>
                    <option value="B">Both</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="PlayStyle" class="control-label"></label>
                <select asp-for="PlayStyle" class="form-control">
                    <option value="All-Rounder">All-Rounder</option>
                    <option value="Zoner">Zoner</option>
                    <option value="Grappler">Grappler</option>
                    <option value="Reversal">Reversal</option>
                    <option value="Rushdown">Rushdown</option>
                    <option value="Puppeteer">Puppeteer</option>
                    <option value="Big Body">Big Body</option>
                </select>
            </div>
            <div class="form-group">
                <label asp-for="SkillLevel" class="control-label"></label>
                <input asp-for="SkillLevel" class="form-control" />
                <span asp-validation-for="SkillLevel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Strengths" class="control-label"></label>
                <input asp-for="Strengths" class="form-control" />
                <span asp-validation-for="Strengths" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Weaknesses" class="control-label"></label>
                <input asp-for="Weaknesses" class="form-control" />
                <span asp-validation-for="Weaknesses" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="GameId" class="control-label"></label>
                <select asp-for="GameId" class="form-control" asp-items="ViewBag.GameId"></select>
                <span asp-validation-for="GameId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
