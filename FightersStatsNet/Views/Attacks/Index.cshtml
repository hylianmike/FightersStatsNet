@model IEnumerable<FightersStatsNet.Models.Attack>

@{
    ViewData["Title"] = "All Attacks";
}

<h1>Attacks</h1>

<p>
    <a asp-action="Create">Add A New Attack</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ButtonInput)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Fighter)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ButtonInput)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Fighter.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.AttackId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.AttackId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.AttackId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
