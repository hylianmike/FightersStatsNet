@model IEnumerable<FightersStatsNet.Models.Fighter>

@{
    ViewData["Title"] = "All Fighters";
}

<h1>Characters</h1>

<p>
    <a asp-action="Create">Add A New Fighter</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Gender)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PlayStyle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SkillLevel)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Game)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Name)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Gender)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PlayStyle)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.SkillLevel)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Game.Name)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.FighterId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.FighterId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.FighterId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
